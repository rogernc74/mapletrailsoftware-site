<!doctype html><html><head><meta charset="utf-8"><style>*{box-sizing:border-box}body{margin:0;background:#fbf6ec;color:#17332c;font-family:Georgia,serif}.card{width:1200px;height:630px;display:grid;grid-template-columns:700px 500px}.copy{padding:38px 55px}.logo{width:135px;height:88px;object-fit:contain;mix-blend-mode:multiply}h1{font-size:62px;font-weight:400;letter-spacing:-.045em;line-height:1.05;margin:25px 0 20px}p{font:24px/1.4 -apple-system,BlinkMacSystemFont,sans-serif;margin:0;max-width:570px}.eyebrow{font:13px -apple-system,BlinkMacSystemFont,sans-serif;text-transform:uppercase;letter-spacing:.16em;color:#a34524;margin-top:20px}.art{height:630px;position:relative;overflow:hidden}.photo{width:100%;height:100%;object-fit:cover;object-position:70% center}.screen{position:absolute;height:500px;width:auto;max-width:90%;object-fit:contain;top:65px;left:50%;transform:translateX(-50%);border-radius:22px;filter:drop-shadow(0 15px 20px #0005)}.acadie,.acadie-fr{color:#112b40}.ifneeded{color:#43233e}.habitwallet{color:#143c30}</style></head><body><div class="card"><div class="copy"><img class="logo" src="/images/editorial/mapletrail-lockup.png"><div class="eyebrow" id="tag"></div><h1 id="title"></h1><p id="sub"></p></div><div class="art"><img class="photo" id="photo"><img class="screen" id="screen"></div></div><script>
const data={mapletrail:['MapleTrail Software Inc.','Thoughtful apps. Personal connections.','For the moments, places, and details worth keeping.','coast','acadie/home-app-2026.jpg'],acadie:['Acadie','Discover the people and places of Acadie.','Available on iOS and Android. English & French.','coast','acadie/home-app-2026.jpg'],'acadie-fr':['Acadie','Découvrez les gens et les lieux de l’Acadie.','Disponible sur iOS et Android. Français et anglais.','coast','acadie/fr-CA/home-app-2026.jpg'],momentslater:['Moments Later','Keep the little moments.','Capture now. Reflect later. iPhone, iPad, Mac & Apple Watch.','memories','momentslater/capture.webp'],habitwallet:['Habit Wallet','Small habits. Rewards you choose.','Turn everyday progress into something to look forward to.','essentials','habitwallet/wallet.webp'],momentsaway:['Moments Away','Remember where life takes you.','Your places. Your stories. Your personal travel record.','coast','momentsaway/map.jpg'],ifneeded:['If Needed','Make the important details easier to find.','Practical information for someone you trust.','essentials','ifneeded/today.jpg']};const key=new URLSearchParams(location.search).get('app')||'mapletrail';const d=data[key];document.body.className=key;document.querySelector('#tag').textContent=d[0];document.querySelector('#title').textContent=d[1];document.querySelector('#sub').textContent=d[2];document.querySelector('#photo').src='/images/editorial/'+d[3]+'.webp';document.querySelector('#screen').src='/images/'+d[4];
